# Python
__pycache__/
*.py[cod]
# No trailing slash: a trailing slash matches only directories, and a .venv SYMLINK to another
# worktree's venv was once committed because of exactly that.
.venv
.venv*
*.egg-info/
build/
dist/

# Model artifacts - fetched, never committed (see THIRD_PARTY_LICENSES.md)
*.task
*.onnx
*.pth

# Local scratch
.mplcache/
*.local.*

# macOS
.DS_Store

# Personal photographs must never be committed. Test fixtures live in
# tests/fixtures/ and must be redistributable; see docs/PLAN.md.
*.HEIC
*.heic
